# Copy this file to .env and fill in real values. .env is gitignored.

# Resend (https://resend.com) API key for sending real email.
# Leave unset to fall back to printing emails to the console in dev.
RESEND_API_KEY=

# Must be an address at a domain verified in your Resend account.
DEFAULT_FROM_EMAIL=NPC Lobby <noreply@npclobby.in>

# Used in the invite email's link.
SITE_URL=https://www.npclobby.in

# Postgres (Neon or any Postgres provider). Leave unset locally to use sqlite instead.
DATABASE_URL=

# Django's cryptographic signing key. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Set to False in production.
DEBUG=True

# Comma-separated list of allowed Host headers. Add your production domain here.
ALLOWED_HOSTS=127.0.0.1,localhost
